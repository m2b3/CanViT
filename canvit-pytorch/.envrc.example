# Machine-specific environment for canvit-pytorch's training, evaluation and
# SLURM scripts. Copy and tailor:
#   cp .envrc.example .envrc && direnv allow
# .envrc is gitignored. SLURM jobs source it under `set -e`: every line must be
# safe there (a bare `cmd1 && cmd2` that evaluates to false kills the shell;
# use `if` or `|| true`).

# Storage: a persistent directory for checkpoints, feature shards and datasets.
export PROJECT_STORAGE=${PROJECT_STORAGE:-$HOME/canvit-storage}
export CHECKPOINTS_DIR=$PROJECT_STORAGE/checkpoints
export FEATURES_DIR=$PROJECT_STORAGE/dinov3_dense_features
export INDEX_DIR="${SCRATCH:-$PROJECT_STORAGE}/dataset_indexes"

# Caches (useful on clusters with fast scratch storage)
export HF_HOME="${SCRATCH:-$HOME}/.huggingface"
export TORCH_HOME="${SCRATCH:-$HOME}/.torch"
export TORCH_COMPILE_CACHE_DIR="${SCRATCH:-$HOME}/.torch_compile_cache"

# Datasets
export IN21K_IMAGE_DIR=/path/to/imagenet21k
export IMAGENET_VAL=/path/to/ILSVRC2012/val  # ImageNet-1k validation images, one directory per class
# ADE20K on local disk:
export ADE20K_ROOT=/path/to/ADEChallengeData2016
# ADE20K on a SLURM cluster: slurm/ade20k.sh unzips this to $SLURM_TMPDIR and
# sets ADE20K_ROOT per job.
export ADE20K_ZIP=$PROJECT_STORAGE/datasets/ade20k/ADEChallengeData2016.zip

# Hugging Face organization, or a local directory laid out like one, holding
# CanViT checkpoints and probes (default: canvit).
# export CANVIT_HUB_ROOT=canvit

# Comet experiment tracking (pretraining and probe training)
export COMET_WORKSPACE=your-workspace
export COMET_PROJECT_NAME=canvit-pretrain  # e.g. canvit-ade20k-probes for probe training

# Credentials (optional)
if [ -f ~/comet_api_key.txt ]; then export COMET_API_KEY=$(cat ~/comet_api_key.txt); fi
if [ -f ~/hf_token.txt ]; then export HF_TOKEN=$(cat ~/hf_token.txt); fi
if [ -z "${HF_TOKEN:-}" ] && [ -f "$HF_HOME/token" ]; then export HF_TOKEN=$(cat "$HF_HOME/token"); fi
