# Python
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
wheels/
.venv/
.pytest_cache/
.ruff_cache/
.coverage

# Machine-specific environment (start from canvit-pytorch/.envrc.example)
.envrc
.env

# Local scratch
.scratch/
throwaway/
*.bak
*.log
profile_*.json

# Run outputs of the Python project
canvit-pytorch/outputs/
canvit-pytorch/output/
canvit-pytorch/results/
canvit-pytorch/logs/
canvit-pytorch/checkpoints/
canvit-pytorch/misc/
canvit-pytorch/bench/pt/results/

# Model and figure artifacts inside the Python project.
canvit-pytorch/**/*.pt
canvit-pytorch/**/*.pth
canvit-pytorch/**/*.bin
canvit-pytorch/**/*.onnx
canvit-pytorch/**/*.onnx.data
canvit-pytorch/**/*.png
canvit-pytorch/**/*.svg
canvit-pytorch/**/*.pdf

# macOS
.DS_Store

# Node.js
node_modules/

# The project page's recorded bundles (site/record_bundles.sh): generated, published with the page by
# site/deploy.sh, never committed.
site/data/

# The paper's figures the page shows (site/copy_paper_figures.sh): generated with the paper, published by deploy.sh.
site/assets/paper/*.svg

# Local screenshots of the project page
site/.screens/

# Exported live models (python -m canvit_pytorch.viz.live export): hundreds of MB, never committed
site/.live-model

# The paper: evaluation results the exporter reads (not distributed), its diagram intermediates, exports the
# manuscript does not read (SVG and PNG renderings, datasets run by name), and LaTeX build outputs.
paper/exporter/data/
paper/exporter/diagrams/outputs/
paper/exporter/diagrams/*.pdf
paper/exporter/diagrams/*.svg
paper/exporter/diagrams/*.png
paper/exports/*.svg
paper/exports/*.png
paper/exports/ablation_seg.json
paper/exports/ablation_in1k_clf.json
paper/latex/*.pdf
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.out
paper/latex/*.maf
paper/latex/*.mtc*
paper/latex/*.ptc*
paper/latex/arxiv_bundle/
paper/latex/arxiv_bundle.tar.gz
