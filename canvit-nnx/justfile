default: lint typecheck test

lint:
    uv run ruff check .
    bash ../tools/check_locks.sh

typecheck:
    uv run --all-extras basedpyright canvit_nnx tests ../canvit-core/canvit_core

test:
    uv run --all-extras pytest ../tests/backends --backend nnx -m 'not network'
    uv run --all-extras pytest tests -m 'not network'
